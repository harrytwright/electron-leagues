{
  "include": ["tools/oxlint/anti-slop/**/*.ts"],
  "exclude": ["tools/oxlint/anti-slop/fixtures/**"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
