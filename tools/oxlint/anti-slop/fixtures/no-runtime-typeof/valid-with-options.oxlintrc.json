{
	"$schema": "../../../../../node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "off",
		"nursery": "off",
		"pedantic": "off",
		"perf": "off",
		"restriction": "off",
		"style": "off",
		"suspicious": "off"
	},
	"jsPlugins": [{ "name": "anti-slop", "specifier": "../../index.ts" }],
	"rules": {
		"anti-slop/no-runtime-typeof": ["error", { "allowInTypeGuards": true }]
	}
}
